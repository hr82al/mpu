# Sandbox mount placeholders (0-байтовые, создаются песочницей при старте сессии).
# Не удалять с диска: удаление смонтированного пути ломает Bash в изолированной сессии.
# .gitmodules — снять эту строку, если в репо появятся настоящие подмодули.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.mcp.json
.gitmodules
.idea

# локальные worktree агентов: чужой чекаут внутри репозитория (`.claude/` трекается)
.claude/worktrees/

# Песочница GitLab: токен и посев — состояние стенда, не поставка
docs/gitlab-sandbox/config/
docs/gitlab-sandbox/seed.json
