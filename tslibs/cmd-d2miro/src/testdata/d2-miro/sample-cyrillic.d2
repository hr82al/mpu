# Контрпример к sample.d2: то же самое кириллическими идентификаторами.
# Парсер читает имя как `[a-zA-Z_]\w*`, поэтому ни один шейп не находит
# пары в SVG, а markdown-блок не распознаётся вовсе.

загрузчик: Загрузчик {
  shape: rectangle
}

витрина: Витрина {
  shape: cylinder
}

карточка: |md
  ## Карточка
|

загрузчик -> витрина: пишет
