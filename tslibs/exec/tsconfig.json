{
  // Строгая проверка типов `tsc --noEmit` — тот же режим, что у `ts/`.
  // `.d.ts` для `dist/` выпускает `tsconfig.build.json`.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    // `DOM.AsyncIterable` — `for await` над веб-потоком процесса, как в `ts/`.
    "lib": [
      "ES2024",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", ".tmp"]
}
