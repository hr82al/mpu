{
  // Объявления типов поверхности: только графы девяти входов, без тестов.
  // Пути в `.d.ts` остаются с `.ts` — `tsc` потребителя находит по ним
  // соседние `.d.ts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": [],
  "files": [
    "index.ts",
    "env.ts",
    "confirm.ts",
    "jsdate.ts",
    "selector.ts",
    "store.ts",
    "config.ts",
    "policy.ts",
    "testing.ts"
  ]
}
