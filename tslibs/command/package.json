{
  "name": "@mpu/command",
  "version": "0.4.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./confirm": {
      "types": "./dist/confirm.d.ts",
      "default": "./dist/confirm.js"
    },
    "./jsdate": {
      "types": "./dist/jsdate.d.ts",
      "default": "./dist/jsdate.js"
    },
    "./selector": {
      "types": "./dist/selector.d.ts",
      "default": "./dist/selector.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test:bun": "bun --bun vitest run",
    "test:node": "node node_modules/vitest/vitest.mjs run",
    "test:deno": "deno run -A --no-config --node-modules-dir=manual node_modules/vitest/vitest.mjs run",
    "build": "rm -rf dist && bun build index.ts env.ts confirm.ts jsdate.ts selector.ts store.ts config.ts policy.ts table.ts testing.ts --target node --packages external --splitting --chunk-naming 'chunk-[hash].[ext]' --outdir dist && tsc -p tsconfig.build.json",
    "release": "bun run build && bun pm pack --destination release",
    "check:release": "bun run build && sh -c 'd=$(mktemp -d) && bun pm pack --destination \"$d\" >/dev/null && f=$(basename \"$d\"/*.tgz) && cmp -s \"$d/$f\" \"release/$f\"; r=$?; rm -rf \"$d\"; [ $r = 0 ] || { echo \"release/$f не совпадает с исходниками — bun run release и закоммить архив\" >&2; exit 1; }'",
    "gate": "bun run lint && bun run typecheck && bun run test:bun && bun run test:node && bun run test:deno && bun run check:release"
  },
  "peerDependencies": {
    "@mpu/base": "0.1.0",
    "@mpu/language": "0.1.0",
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {
    "@mpu/base": {
      "optional": true
    },
    "@mpu/language": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mpu/base": "file:../base/release/mpu-base-0.1.0.tgz",
    "@mpu/language": "file:../language/release/mpu-language-0.1.0.tgz",
    "@mpu/testing": "file:../testing/release/mpu-testing-0.2.0.tgz",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "4.4.3"
  }
}
