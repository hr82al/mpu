{
  // Объявления типов поверхности: только граф `index.ts`, без тестов.
  // Пути в `.d.ts` остаются с `.ts` — `tsc` потребителя находит по ним
  // соседние `.d.ts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": [],
  "files": ["index.ts"]
}
