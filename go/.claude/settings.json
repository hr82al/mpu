  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git:*)",
            "statusMessage": "Проверка git-команды",
            "command": "c=$(jq -r '.tool_input.command'); echo \"$c\" | grep -Eq '(^|[;&|(][[:space:]]*)git([[:space:]]+-[^[:space:]]+)*[[:space:]]+(stash|add|commit)([[:space:]]|$)' || exit 0; { echo \"$c\" | grep -Eq '(^|[;&|(][[:space:]]*)git([[:space:]]+-[^[:space:]]+)*[[:space:]]+stash([[:space:]]|$)' || echo \"$c\" | grep -Eq '(^|[[:space:]])-[A-Za-z]*[Aau][A-Za-z]*([[:space:]]|$)|(^|[[:space:]])(--all|\\.\\.|:/)([[:space:]]|$)'; } || exit 0; echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"py/ и docs/ закрыты песочницей и выглядят для git удалёнными — массовая операция закоммитит удаление py/. Работать с pathspec: git add go/…, git commit -m … -- go/\"}}'"
          }
        ]
      }
    ]
  },
