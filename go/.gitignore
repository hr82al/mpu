# Скомпилированные бинари и объектники
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
/mpu
/bin/
/dist/

# Покрытие и профили
*.out
coverage.txt
*.prof

# Кэш сборки и временные файлы Go (перенаправлены внутрь go/ через
# .claude/settings.json; кэш модулей общий — в ~/go/pkg/mod)
.gocache/
.gotmp/

# Vendored-зависимости (не используем; фиксируем через go.sum)
/vendor/

# workspace-файлы Go (локальные, не коммитим)
go.work
go.work.sum

# Настройки IDE и редакторов
/.idea
/.vscode
*.swp

# Локальное окружение оболочки и инструментов
/.bashrc
/.bash_profile
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.ripgreprc
/.mcp.json

# Локальная обвязка Claude Code; в репозитории живут только settings.json и
# lock.sh, остальное у каждого своё
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/skills
/.claude/workflows
/.claude/routines
/.claude/output-styles
/.claude/launch.json
/.claude/loop.md
