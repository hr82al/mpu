{
  // Целевая версия Deno — 2.x. Точный номер фиксируется при первом
  // зелёном прогоне гейтов: в среде этой сессии бинаря Deno нет
  // (см. отчёт первой задачи реализации), проверить `deno --version`
  // было негде.
  // служебные каталоги сессии и артефакты покрытия — вне инструментов
  "exclude": [".deno", ".tmp", "cov"],
  "fmt": {
    // golden-фикстуры сверяются байт-в-байт — форматировать нельзя
    "exclude": ["src/xlsx/testdata"]
  },
  "imports": {
    // тесты: assertEquals/assertThrows с читаемыми сообщениями.
    // При первом прогоне с реальным Deno сгенерировать и закоммитить
    // deno.lock (правило «версии фиксируются») — в среде этой сессии
    // бинаря нет, lock создать было нечем.
    "@std/assert": "jsr:@std/assert@^1.0.6"
  },
  "tasks": {
    // Запись нужна только временным каталогам тестов (Deno.makeTempDir);
    // сузить write/env до минимума при первом зелёном прогоне —
    // без бинаря Deno фактический минимум не подтвердить.
    "test": "deno test --allow-read --allow-write --allow-env",
    // права зашиваются в бинарь: диск на чтение (файлы пользователя),
    // запись — только конфиг-каталог, env — только MPU_XLSX и HOME,
    // запуск — только открыватели файлов
    "build": "deno compile --allow-read --allow-write=$HOME/.config/mpu --allow-env=MPU_XLSX,HOME --allow-run=xdg-open,open -o $HOME/.local/bin/mpu main.ts"
  }
}
