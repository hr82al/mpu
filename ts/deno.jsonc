{
  // Разрабатывается и проверяется на Deno 2.9.4 (стабильная ветка 2.x).
  // служебные каталоги сессии и артефакты покрытия — вне инструментов.
  // `.claude` в их числе: песочница подменяет файлы удалённого профиля
  // заглушками-устройствами, и чтение такой «настройки» роняет `deno fmt`.
  "exclude": [".claude", ".deno", ".tmp", "cov"],
  "fmt": {
    // `docs/` — канал спецификаций: его пишет сессия-спецификатор, у
    // которой Deno нет. Прогон `deno fmt` без pathspec переписывал там
    // файлы, а вместе с ними — чужую несохранённую работу; форматировать
    // этот каталог реализующая сессия не должна вовсе.
    // Отдельно golden-фикстуры (обе стороны сверки: канал и его копия в
    // тестовом каталоге) сверяются байт-в-байт: отформатировать одну из
    // них — молча развести их.
    "exclude": ["docs", "src/mcp/testdata", "src/xlsx/testdata"]
  },
  "imports": {
    // тесты: assertEquals/assertThrows с читаемыми сообщениями.
    "@std/assert": "jsr:@std/assert@^1.0.6",
    // объявление схемы аргументов и результата команды: из одного
    // объявления берутся и проверка входа, и статический тип, и схема
    // тула для MCP-сервера (`platform/command-contract.md` требует ровно
    // этой пары «схема + тип»). У ручного предиката на каждое поле
    // рассинхрон с типом компилятору не виден, а схему тула пришлось бы
    // писать третий раз. Своих зависимостей у пакета нет.
    // Версия зафиксирована точно, без «^»: диапазон разрешается в самый
    // свежий релиз апстрима, то есть состав зависимостей меняется от даты
    // сборки. Бампить с задержкой: Deno с 2.9 по умолчанию не берёт версии
    // моложе суток (minimumDependencyAge), а у точного пина, в отличие от
    // диапазона, отката на предыдущую версию нет — разрешение упадёт.
    "@zod/zod": "jsr:@zod/zod@4.4.3",
    // HTTP-транспорт MCP-сервера: маршрутизация путей профилей `/ro` и
    // `/rw`, разбор запроса и сборка ответа поверх `Deno.serve`. Своими
    // руками это писать не нужно, а стандартной библиотеке роутера нет;
    // Hono работает на веб-API (`Request`/`Response`), поэтому ядро
    // диспетчера от него не зависит и остаётся тестируемым без сокета.
    // Зависимостей у пакета нет.
    // Версия зафиксирована точно, без «^»: по тем же причинам, что у
    // `@zod/zod` выше.
    "@hono/hono": "jsr:@hono/hono@4.12.33"
  },
  "tasks": {
    // Тестам нужны чтение исходников с фикстурами, временные каталоги
    // (Deno.makeTempDir пишет в $TMPDIR) и env — подстановка HOME/MPU_*
    // в тестах хранилища. Сеть — только петля: тесты транспорта поднимают
    // MCP-сервер на 127.0.0.1 и ходят в него fetch'ем. Наружу тест не
    // ходит: ему нужен фейк, а не право.
    // `--allow-run=…` — только для теста запуска подпроцесса маршрута
    // `legacy`: сам маршрут в тестах подставляет фейкового исполнителя,
    // а этими путями проверяется обёртка над API Deno — захват потоков,
    // код возврата и перевод «файла нет» в свой класс ошибки. Третий
    // путь заведомо не существует: без права на него Deno отвечает
    // «нет права» раньше, чем «нет файла», и ветка осталась бы
    // непроверенной.
    "test": "deno test --allow-read --allow-write --allow-env --allow-net=127.0.0.1 --allow-run=/bin/echo,/bin/false,/bin/net-takogo-binarya",
    // Права зашиваются в бинарь при сборке. Они — гигиена, а не барьер
    // (см. CLAUDE.md, «Права Deno»): фиксируют, куда команда вправе
    // тянуться, и делают расширение заметным. По строке на право:
    //   --allow-read                     без ограничения пути: аргумент
    //     команды — произвольный файл пользователя (`mpu xlsx <файл>`),
    //     заранее известного корня у него нет;
    //   --allow-write=$HOME/.config/mpu,$HOME/.bashrc,$HOME/.zshrc
    //     конфиг-каталог — хранилище настроек и файл токена доступа
    //     (оба 0600); rc-файлы — установка дополнения
    //     (`mpu --install-completion`, `platform/registry.md`): она
    //     дописывает скрипт в конец файла и другого места записи не
    //     знает. Списком именно этих файлов, а не всего $HOME: промах
    //     мимо них — ошибка, и её видно сразу;
    //   --allow-env=MPU_XLSX,HOME,_MPU_COMPLETE,COMP_WORDS,COMP_CWORD,_TYPER_COMPLETE_ARGS
    //     HOME даёт путь конфига, rc-файла и реализации маршрута
    //     `legacy`; MPU_XLSX — env-слой ключа xlsx.default
    //     (`platform/config.md`), прочие MPU_* добавляются вместе с
    //     командами, которые их читают; остальные четыре — режим
    //     дополнения: `_MPU_COMPLETE` включает его и читается до
    //     разбора argv, то есть на любой команде, а COMP_WORDS с
    //     COMP_CWORD (bash) и `_TYPER_COMPLETE_ARGS` (zsh) сообщают
    //     набранную строку. Имена задаёт не код, а скрипт дополнения в
    //     rc-файле пользователя (эталон
    //     `fixtures/platform/registry/completion-*.txt`) — сузить
    //     список нельзя. `SHELL` в списке нет намеренно: shell
    //     определяется по дереву процессов-предков (`src/runtime`), а
    //     не по этой переменной;
    //   --allow-net=127.0.0.1            слушающий сокет `mpu mcp`: только
    //     локальный интерфейс, наружу сервер не ходит;
    //   --allow-run                      открыватель файла (xdg-open,
    //     open) и Python-реализация маршрута `legacy`. Списком имён это
    //     больше не выражается: путь к реализации — ключ конфига
    //     `mcp.legacy_bin`, он задаётся пользователем и заранее
    //     неизвестен. Барьером права и не были (см. CLAUDE.md, «Права
    //     Deno»): запускается то, что пользователь сам прописал в своём
    //     конфиге, и его же правами. Сузить обратно можно будет, когда
    //     путь перестанет быть настраиваемым.
    // Пересборка записей маршрута `legacy` из слепка дерева: запускать
    // после его пересъёма. Правки записей руками тест не пропустит.
    "registry:sync": "deno run --allow-read --allow-write=src/registry/legacy_tree.ts scripts/gen-legacy-tree.ts && deno fmt src/registry/legacy_tree.ts",
    "build": "deno compile --allow-read --allow-write=$HOME/.config/mpu,$HOME/.bashrc,$HOME/.zshrc --allow-env=MPU_XLSX,HOME,_MPU_COMPLETE,COMP_WORDS,COMP_CWORD,_TYPER_COMPLETE_ARGS --allow-run --allow-net=127.0.0.1 -o $HOME/.local/bin/mpu main.ts",
    // Проверка собранного бинаря: `deno test` идёт с широкими правами и
    // нехватку прав в задаче `build` не видит — её ловит только запуск
    // бинаря. Права самого скрипта широки по делу: он собирает бинарь
    // во временный каталог (`--allow-write`) и запускает сначала `deno`,
    // потом собранное (`--allow-run`) — оба пути заранее неизвестны.
    "smoke": "deno run --allow-read --allow-write --allow-run scripts/smoke.ts"
  }
}
