{
  // Разрабатывается и проверяется на Deno 2.9.4 (стабильная ветка 2.x).
  // служебные каталоги сессии и артефакты покрытия — вне инструментов.
  // `.claude` в их числе: песочница подменяет файлы удалённого профиля
  // заглушками-устройствами, и чтение такой «настройки» роняет `deno fmt`.
  "exclude": [".claude", ".deno", ".tmp", "cov"],
  "fmt": {
    // `docs/` — канал спецификаций: его пишет сессия-спецификатор, у
    // которой Deno нет. Прогон `deno fmt` без pathspec переписывал там
    // файлы, а вместе с ними — чужую несохранённую работу; форматировать
    // этот каталог реализующая сессия не должна вовсе.
    // Отдельно golden-фикстуры (обе стороны сверки: канал и его копия в
    // тестовом каталоге) сверяются байт-в-байт: отформатировать одну из
    // них — молча развести их.
    "exclude": [
      "docs",
      "src/env/testdata",
      "src/exec/testdata",
      "src/health/testdata",
      "src/nodecli/testdata",
      "src/ps/testdata",
      "src/runjs/testdata",
      "src/sql/testdata",
      "src/ssh/testdata",
      "src/mcp/testdata",
      "src/xlsx/testdata",
      "src/kiten/testdata",
      "src/telegram/testdata",
      "src/claudehook/testdata",
      "src/sheet/testdata",
      "src/mr/testdata",
      "src/config/testdata",
      "src/mpinit/testdata",
      "src/cleanlocal/testdata",
      "src/glab/testdata",
      "src/api/testdata"
    ]
  },
  "imports": {
    // тесты: assertEquals/assertThrows с читаемыми сообщениями.
    "@std/assert": "jsr:@std/assert@^1.0.6",
    // тесты: FakeTime подменяет Date/setTimeout — таймауты PG-обращений
    // проверяются без реального сна и без гонки со стенными часами
    // (`ts/CLAUDE.md`, «Асинхронность и конкурентность»).
    "@std/testing/time": "jsr:@std/testing@^1.0.20/time",
    // объявление схемы аргументов и результата команды: из одного
    // объявления берутся и проверка входа, и статический тип, и схема
    // тула для MCP-сервера (`platform/command-contract.md` требует ровно
    // этой пары «схема + тип»). У ручного предиката на каждое поле
    // рассинхрон с типом компилятору не виден, а схему тула пришлось бы
    // писать третий раз. Своих зависимостей у пакета нет.
    // Версия зафиксирована точно, без «^»: диапазон разрешается в самый
    // свежий релиз апстрима, то есть состав зависимостей меняется от даты
    // сборки. Бампить с задержкой: Deno с 2.9 по умолчанию не берёт версии
    // моложе суток (minimumDependencyAge), а у точного пина, в отличие от
    // диапазона, отката на предыдущую версию нет — разрешение упадёт.
    "@zod/zod": "jsr:@zod/zod@4.4.3",
    // HTTP-транспорт MCP-сервера: маршрутизация путей профилей `/ro` и
    // `/rw`, разбор запроса и сборка ответа поверх `Deno.serve`. Своими
    // руками это писать не нужно, а стандартной библиотеке роутера нет;
    // Hono работает на веб-API (`Request`/`Response`), поэтому ядро
    // диспетчера от него не зависит и остаётся тестируемым без сокета.
    // Зависимостей у пакета нет.
    // Версия зафиксирована точно, без «^»: по тем же причинам, что у
    // `@zod/zod` выше.
    "@hono/hono": "jsr:@hono/hono@4.12.33",
    // Единственный клиент PostgreSQL бинаря: `mpu sql-ro`
    // (`docs/specs/sql-ro.md`) и `mpu update` (`docs/specs/update.md`).
    // Своими руками это проводной протокол PostgreSQL целиком, а в
    // стандартной библиотеке Deno клиента БД нет вовсе. Выбран по живой
    // проверке кандидатов на PostgreSQL 16: произвольный текст
    // пользователя должен уходить серверу одним вызовом с результатом по
    // оператору `;`-склейки (спека `sql-ro` печатает ПЕРВЫЙ), а
    // расширенный протокол соседних клиентов многооператорный текст
    // запрещает. `mpu update` переведён на него же порцией
    // `refactor(update)`: два драйвера ради трёх фиксированных SELECT'ов
    // держать незачем.
    // Версия зафиксирована точно, без «^»: по тем же причинам, что у
    // `@zod/zod` выше. Своих типов пакет не несёт — нужную часть его
    // поверхности объявляет каждый потребитель у себя (`src/sql/pg.ts`,
    // `src/update/pg.ts`); шесть транзитивных
    // зависимостей (`pg-types`, `pg-protocol`, `pg-pool`, `pgpass`,
    // `pg-connection-string`, `pg-cloudflare`) — состав апстрима.
    "pg": "npm:pg@8.22.0",
    // Клиент MTProto для `mpu telegram send` (`docs/specs/telegram-send.md`,
    // `platform/telegram-mtproto.md`): отправка от имени личного аккаунта,
    // не бота. Своими руками это шифрование MTProto, схема TL и транспорт
    // с прокси; в стандартной библиотеке Deno ничего этого нет.
    //   `@mtcute/deno`             — клиент и транспорт под Deno, включая
    //     разбор URL прокси (socks4/socks5/http/https);
    //   `@mtcute/convert`          — строка сессии в формате прежней
    //     реализации клиентом не принимается как есть; конвертер переводит
    //     её в вид, который берёт `importSession`. Без него переезд
    //     потребовал бы повторного входа оператора, а спека требует
    //     принимать записанную строку и не переписывать её;
    //   `@mtcute/markdown-parser`  — флаг `--md`: `[текст](url)` обязан
    //     стать сущностью-ссылкой, а не остаться текстом.
    // Транзитивное дерево, которое тянут эти три: jsr — `@mtcute/core`,
    // `@mtcute/file-id`, `@mtcute/html-parser`, `@mtcute/tl-runtime`,
    // `@mtcute/wasm`, `@fuman/deno`, `@fuman/io`, `@fuman/net`,
    // `@fuman/utils`, `@std/io`; npm — `htmlparser2` с семейством
    // `domhandler`/`domutils`/`dom-serializer`/`domelementtype`/`entities`
    // и `long`. Семейство htmlparser тянет ядро, а не парсер HTML:
    // отцепить его, отказавшись от html-разметки, нельзя — проверено.
    // Версия зафиксирована точно, без «^», и бампится ОТДЕЛЬНОЙ порцией:
    // библиотека держит в руках строку сессии и api-hash, у неё есть
    // бинарный wasm-модуль, поэтому её обновление — смена того, кому
    // доверен секрет, а не рутинная правка версии.
    "@mtcute/deno": "jsr:@mtcute/deno@0.31.0",
    "@mtcute/convert": "jsr:@mtcute/convert@0.31.0",
    "@mtcute/markdown-parser": "jsr:@mtcute/markdown-parser@0.31.0"
  },
  "tasks": {
    // Тестам нужны чтение исходников с фикстурами, временные каталоги
    // (Deno.makeTempDir пишет в $TMPDIR) и env — подстановка HOME/MPU_*
    // в тестах хранилища; `--allow-env` здесь без списка (тесты сами
    // переставляют разные переменные, включая XDG_CONFIG_HOME для
    // `src/env`, — сузить список так, чтобы не гнаться за ним на
    // каждый новый тест, не даёт смысла). Сеть — только петля: тесты
    // транспорта поднимают MCP-сервер на 127.0.0.1 и ходят в него
    // fetch'ем. Наружу тест не ходит: ему нужен фейк, а не право.
    // `--allow-run=…` — только для теста запуска подпроцесса маршрута
    // `legacy`: сам маршрут в тестах подставляет фейкового исполнителя,
    // а этими путями проверяется обёртка над API Deno — захват потоков,
    // код возврата и перевод «файла нет» в свой класс ошибки. Третий
    // путь заведомо не существует: без права на него Deno отвечает
    // «нет права» раньше, чем «нет файла», и ветка осталась бы
    // непроверенной.
    "test": "deno test --allow-read --allow-write --allow-env --allow-net=127.0.0.1 --allow-run=/bin/echo,/bin/false,/bin/net-takogo-binarya",
    // Права зашиваются в бинарь при сборке. Они — гигиена, а не барьер
    // (см. CLAUDE.md, «Права Deno»): фиксируют, куда команда вправе
    // тянуться, и делают расширение заметным. По строке на право:
    //   --allow-read                     без ограничения пути: аргумент
    //     команды — произвольный файл пользователя (`mpu xlsx <файл>`),
    //     заранее известного корня у него нет;
    //   --allow-write=$HOME/.config/mpu,$HOME/.bashrc,$HOME/.zshrc
    //     конфиг-каталог — хранилище настроек и файл токена доступа
    //     (оба 0600); rc-файлы — установка дополнения
    //     (`mpu --install-completion`, `platform/registry.md`): она
    //     дописывает скрипт в конец файла и другого места записи не
    //     знает. Списком именно этих файлов, а не всего $HOME: промах
    //     мимо них — ошибка, и её видно сразу. Запись env-файла
    //     (`envFile.set`, `platform/env-file.md`) при нестандартном
    //     XDG_CONFIG_HOME целится вне $HOME/.config/mpu — этот список
    //     её не покрывает, и запись упрётся в отказ права. `/dev/tty` —
    //     копирование в буфер обмена управляющей последовательностью
    //     (`platform/clipboard.md`, попытка 1): без этого пути попытка
    //     всегда неуспешна и молча уступает внешней утилите;
    //     `/tmp` и `/var/tmp` — каталог временных файлов: дамп
    //     `copy-client` и `copy-dev` пишется во временный файл
    //     (`docs/specs/copy-client.md`, «Известные ловушки»), и без
    //     этого права собранный бинарь падает `Requires write access to
    //     <TMP>` ещё до первого обращения к PG. Явными путями, а не
    //     `$TMPDIR`: при незаданной переменной элемент списка пуст, и
    //     Deno отвечает `Empty values are not allowed` — бинарь
    //     перестаёт запускаться вообще у всех. Два пути, а не один:
    //     сам код `/var/tmp` никогда не выбирает — туда пишут, только
    //     если оператор направит `TMPDIR`, а направить бывает нужно:
    //     `/tmp` часто в памяти, а дамп клиента бывает десятками
    //     гигабайт. `TMPDIR`, указывающий куда-то ещё, правом не
    //     покрыт — отказ переводится в понятный текст
    //     (`src/copy/tools.ts`, `makeDumpFile`);
    //   --allow-env=HOME,XDG_CONFIG_HOME,MPU_MP_CONFIG_LOCAL,COLUMNS,_MPU_COMPLETE,COMP_WORDS,COMP_CWORD,_TYPER_COMPLETE_ARGS,PG*
    //     HOME даёт путь конфига, rc-файла и реализации маршрута
    //     `legacy`; XDG_CONFIG_HOME — путь env-файла секретов
    //     (`platform/env-file.md`, «Известные отклонения»: учёт этой
    //     переменной — внешний контракт существующей машины, вердикт
    //     preserve, не наша идея). Оба нужны на каждый запуск бинаря:
    //     `makeDenoIo` (`src/runtime/mod.ts`) безусловно резолвит путь
    //     env-файла через `envFilePath`, чтобы решить, заводить ли
    //     хранилище, — до всякого обращения к самому файлу (мутация
    //     «убрать XDG_CONFIG_HOME» роняет любую проверку ниже с
    //     «Requires env access», отдельный smoke-сценарий не нужен).
    //     Ради конфиг-ключей самого файла (MPU_XLSX, `sl_<N>`, `pg_<N>`,
    //     `PG_*`, `DEV_*`, `MPU_LOG_*` — `platform/env-file.md`,
    //     «Конфигурация») список не расширяется и расширяться не будет:
    //     с 2026-08-05 слой `envFile` окружение процесса не читает вовсе
    //     (решение спеки, «Ввод/вывод» и «Известные отклонения») —
    //     `envFile.get/require/set` разбирают только файл, `Deno.env.get`
    //     не зовут, и права на чтение ключа команде-потребителю не
    //     нужно (часть имён на `PG` попадает под префикс ниже —
    //     побочно, не ради них). Остальные четыре — режим дополнения:
    //     `_MPU_COMPLETE` включает его и читается до разбора argv, то
    //     есть на любой команде, а COMP_WORDS с COMP_CWORD (bash) и
    //     `_TYPER_COMPLETE_ARGS` (zsh) сообщают набранную строку. Имена
    //     задаёт не код, а скрипт дополнения в rc-файле пользователя
    //     (эталон `fixtures/platform/registry/completion-*.txt`) —
    //     сузить список нельзя. `SHELL` в списке нет намеренно: shell
    //     определяется по дереву процессов-предков (`src/runtime`), а
    //     не по этой переменной. Единственная запись не из этого ряда —
    //     префикс `PG*`: клиент PostgreSQL (`npm:pg` — см. `imports`
    //     выше) читает свои умолчания из окружения прежде, чем слить их
    //     с нашими опциями, и без права клиент не создаётся вовсе
    //     (`NotCapable`; ловят обе smoke-проверки подключения). Имена
    //     читаются россыпью (`PGHOST`, `PGUSER`,
    //     `PGPASSWORD`, `PGBINARY`, `PGOPTIONS`, `PGSSLNEGOTIATION`,
    //     `PGAPPNAME`, …), их состав — не контракт библиотеки, поэтому
    //     право сужено префиксом, а не списком: новое имя в апстриме не
    //     должно ронять команду. Цена префикса названа честно: под него
    //     попадают и ключи env-файла с тем же началом (`PG_PORT`,
    //     `PG_MY_USER_PASSWORD`), то есть право читать их у бинаря
    //     формально есть. На поведение это не влияет: слой `envFile`
    //     окружение процесса не читает вовсе, а всё, что читает
    //     драйвер, перекрыто явными опциями обоих модулей-потребителей
    //     (`src/sql/pg.ts`, `src/update/pg.ts`) — кроме
    //     `PGBINARY` и `PGREPLICATION`, чьё умолчание ложно и потому
    //     неперекрываемо; экспорт этих двух в shell меняет режим
    //     протокола;
    //   --allow-net                      слушающий сокет `mpu mcp` (только
    //     `127.0.0.1`, наружу сервер не ходит) и исходящие вызовы `mpu
    //     init` (Portainer, Loki, Kaiten — `docs/specs/init.md`) и `mpu
    //     update` (PostgreSQL main и инстансов, Loki —
    //     `docs/specs/update.md`). Списком
    //     адресов это не выражается — их задаёт пользователь ключами
    //     env-файла (`PORTAINER_URL`, `LOKI_URL`, `KITEN_BASE_URL`,
    //     `pg_<N>`), а
    //     `KITEN_BASE_URL` вдобавок имеет дефолт-адрес стенда. Сузить
    //     обратно можно будет, если адреса когда-нибудь перестанут быть
    //     настраиваемыми. Честно: smoke отличить широкое право от
    //     `=127.0.0.1` не может — его фейковые серверы живут на петле;
    //     наружу тесты не ходят намеренно (им нужен фейк, а не право);
    //   --allow-run                      открыватель файла (xdg-open,
    //     open) и Python-реализация маршрута `legacy` — её же зовёт шаг 5
    //     `mpu init` (`mpu telegram login` с проброшенным терминалом,
    //     `docs/specs/init.md`). Списком имён это
    //     больше не выражается: путь к реализации — ключ конфига
    //     `mcp.legacy_bin`, он задаётся пользователем и заранее
    //     неизвестен. Барьером права и не были (см. CLAUDE.md, «Права
    //     Deno»): запускается то, что пользователь сам прописал в своём
    //     конфиге, и его же правами. Сузить обратно можно будет, когда
    //     путь перестанет быть настраиваемым.
    // Пересборка записей маршрута `legacy` из слепка дерева: запускать
    // после его пересъёма. Правки записей руками тест не пропустит.
    "registry:sync": "deno run --allow-read --allow-write=src/registry/legacy_tree.ts scripts/gen-legacy-tree.ts && deno fmt src/registry/legacy_tree.ts",
    // Пересъём снапшотов публикуемых тулов: запускать, когда меняется
    // состав команд реестра или закрытый список публикации. Текст
    // собирает та же функция, что сверяет инвариант MCP, поэтому
    // `deno fmt` по результату не гоняется — `src/mcp/testdata`
    // исключён из форматирования и сверяется байт-в-байт.
    "tools:snapshot": "deno run --allow-read --allow-write=src/mcp/testdata/tools-ro.json,src/mcp/testdata/tools-rw.json scripts/gen-tool-snapshots.ts",
    //   MTCUTE_LOG_LEVEL                 клиент MTProto читает уровень
    //     своего лога при создании (`@mtcute/deno` — см. `imports`), до
    //     первого обращения к сети; без права `mpu telegram send`
    //     падает на каждом вызове с «Requires env access». Имя одно и
    //     задаётся библиотекой; smoke-проверка «ленивый клиент MTProto
    //     есть в бинаре» краснеет, если право убрать. `TMUX` —
    //     признак терминала-мультиплексора: под ним управляющая
    //     последовательность буфера обмена заворачивается в passthrough
    //     (`platform/clipboard.md`), иначе tmux её съедает. Оба права
    //     буфера обмена (`/dev/tty` и `TMUX`) smoke-проверкой не
    //     закрываются: их отсутствие даёт ровно тот же наблюдаемый
    //     исход, что и запуск без терминала, — неуспешную попытку,
    //     после которой команда работает как обычно.
    //   --deny-env=USER,NODE_PG_FORCE_NATIVE
    //     Единственные два имени вне списка выше, к которым тянется
    //     дерево `npm:pg`: `USER` — умолчание имени пользователя
    //     (`pg/lib/defaults.js`), `NODE_PG_FORCE_NATIVE` — переключение
    //     клиента на `pg-native` при загрузке модуля (`pg/lib/index.js`).
    //     Свип чтений окружения по всему дереву зависимостей 2026-08-20:
    //     остальные читаемые имена начинаются с `PG` и покрыты
    //     префиксом выше. Оба значения бинарю не нужны: имя пользователя
    //     перекрыто явными опциями обоих модулей-потребителей
    //     (`src/sql/pg.ts`, `src/update/pg.ts`), а `NODE_PG_FORCE_NATIVE`
    //     из окружения молча сменил бы клиент — тот же класс, что
    //     `PGBINARY`/`PGREPLICATION` выше, только предотвратимый.
    //     Поэтому запрет, а не право: оба чтения у драйвера обёрнуты в
    //     `try/catch` и отказ ему безразличен, но без запрета Deno на
    //     терминале спрашивает разрешение на каждое из них — а под
    //     MCP-клиентом такой вопрос повесил бы `mpu mcp` без вывода.
    //     Наблюдаемого поведения флаг не меняет (неинтерактивно доступ и
    //     так отказан), поэтому smoke его не покрывает — исключение
    //     названо в `CLAUDE.md`, «Проверка каждого изменения»;
    "build": "deno compile --allow-read --allow-write=$HOME/.config/mpu,$HOME/.bashrc,$HOME/.zshrc,/dev/tty,/tmp,/var/tmp --allow-env=HOME,XDG_CONFIG_HOME,MPU_MP_CONFIG_LOCAL,COLUMNS,_MPU_COMPLETE,COMP_WORDS,COMP_CWORD,_TYPER_COMPLETE_ARGS,PG*,MTCUTE_LOG_LEVEL,TMUX --deny-env=USER,NODE_PG_FORCE_NATIVE --allow-run --allow-net -o $HOME/.local/bin/mpu main.ts",
    // Проверка собранного бинаря: `deno test` идёт с широкими правами и
    // нехватку прав в задаче `build` не видит — её ловит только запуск
    // бинаря. Права самого скрипта широки по делу: он собирает бинарь
    // во временный каталог (`--allow-write`) и запускает сначала `deno`,
    // потом собранное (`--allow-run`) — оба пути заранее неизвестны.
    //     `--allow-env=HOME,XDG_CONFIG_HOME` — ради одной проверки:
    //     сверки голденов схемы с живой `information_schema` main-БД.
    //     Реквизиты подключения лежат в env-файле оператора, а путь к
    //     нему строится из этих двух переменных (`src/env/mod.ts`).
    //     Без них проверка неисполнима: временный HOME скрипта чужих
    //     реквизитов не содержит. Право узкое и на чтение — прочих
    //     переменных скрипт не видит. Сеть при этом осталась прежней,
    //     `127.0.0.1`: «только локальный стенд» держится правом, а не
    //     намерением — с прод-настройками проверка не дотянется до
    //     чужой базы и честно пропустится;
    "smoke": "deno run --allow-read --allow-write --allow-run --allow-env=HOME,XDG_CONFIG_HOME --allow-net=127.0.0.1 scripts/smoke.ts",
    // Ячейка передачи работы между сессиями (`handoff/`): обе роли ходят
    // в неё этой задачей, а не читают и переписывают файл руками. Права
    // узкие по делу: чтение — постановка или отчёт с диска, запись —
    // сама ячейка и её временный файл, env — переопределение пути
    // (`HANDOFF_CELL`) на время проверок.
    "handoff": "deno run --allow-read --allow-write=.tmp --allow-env=HANDOFF_CELL handoff/main.ts"
  }
}
