 {
  "name": "get-token",
  "method": "POST",
  "path": "/auth/login",
  "summary": "POST /auth/login → print accessToken (cached 10 min)",
  "description": "POST /auth/login. По умолчанию использует TOKEN_EMAIL / TOKEN_PASSWORD из ~/.config/mpu/.env. Кэширует токен в ~/.config/mpu/.api-token.json (TTL 10 мин); последующие mpuapi-* команды переиспользуют его.",
  "path_params": [],
  "body_fields": [
   {
    "name": "email",
    "type": "string",
    "required": false,
    "description": "login email (default: env TOKEN_EMAIL)"
   },
   {
    "name": "password",
    "type": "string",
    "required": false,
    "description": "password (default: env TOKEN_PASSWORD)"
   }
  ],
  "accepts_raw_body": false,
  "no_auth": true,
  "token_only": true
 },
