# Синтетический вход для фикстур переноса `mpu d2-miro`.
# Состав задан спекой: два шейпа, контейнер, card, markdown-блок и
# двунаправленная пара рёбер.
#
# Идентификаторы латинские, метки в кавычках — это и есть поддерживаемое
# подмножество: имя шейпа парсер читает как `[a-zA-Z_]\w*`, а метку берёт
# только из кавычек. Кириллическое имя молча остаётся без пары и всплывает
# предупреждением «in SVG but not in d2 source» (см. sample-cyrillic.d2).

loader: "Загрузчик" {
  shape: rectangle
}

mart: "Витрина" {
  shape: cylinder
}

recalc: "Пересчёт" {
  check: "Сверка со стендом"
  report: "Отчёт"
  check -> report
}

card: |md
  ## Карточка
  - срок 31.08
  - 5.5 ч
|

loader -> mart: "пишет"
mart -> loader: "курсор"
mart -> recalc.check
recalc.report -> card
