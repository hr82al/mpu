{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mpu-back: кадры строки и методы /rpc",
  "description": "platform/back-rpc.md. Строка — GET /line и GET /agent/line (WebSocket), кадры — текстовые, каждый — один JSON-объект. Запросы — POST /rpc, JSON-RPC 2.0. Та же строка простым HTTP — POST /line и POST /agent/line (platform/back-http-line.md): кадры потоком NDJSON или один собранный объект; вопрос — кадром ask с номером ticket, ответ — POST …/answer.",
  "$defs": {
    "line.client.first": {
      "description": "Первый кадр клиента: строка, каталог клиента, есть ли кого спросить и контекст вызова (platform/call-context.md): ввод, терминальность и переменные клиента. Любое из трёх полей приходит без остальных; поля нет — как до порции 11 (пустой ввод, потоки не терминалы, окружение сервера).",
      "type": "object",
      "required": [
        "words",
        "cwd"
      ],
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "pattern": "^/"
        },
        "human": {
          "type": "boolean",
          "default": false
        },
        "stdin": {
          "description": "Весь ввод строки; поля нет — ввода нет. Больше 8 МиБ (в байтах UTF-8) — отказ mpu-back: ввод больше 8 МиБ, код 2.",
          "type": "string"
        },
        "tty": {
          "description": "Терминальность трёх потоков клиента и ширина его консоли; поля нет — все три false, ширины нет. columns — только при stdout: true, иначе отказ mpu-back: ширина без терминала.",
          "type": "object",
          "properties": {
            "stdin": {
              "type": "boolean",
              "default": false
            },
            "stdout": {
              "type": "boolean",
              "default": false
            },
            "stderr": {
              "type": "boolean",
              "default": false
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        "env": {
          "description": "Переменные окружения клиента; поля нет или объект пуст — окружение сервера как есть. Имена — закрытый список (только про вид вывода); имя вне его — отказ mpu-back: переменная вне списка: ИМЯ, код 2. Переменные действуют только на свою строку.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "COLUMNS",
              "NO_COLOR",
              "TERM",
              "TERM_PROGRAM",
              "COLORTERM",
              "TMUX",
              "WT_SESSION",
              "OS"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "line.client.answer": {
      "description": "Ответ на кадр ask; y или yes в любом регистре — «да».",
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": {
          "type": "string"
        }
      }
    },
    "line.server": {
      "description": "Кадр сервера; exit — последний, после него сокет закрывается с кодом 1000.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "out"
          ],
          "properties": {
            "out": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "err"
          ],
          "properties": {
            "err": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ask"
          ],
          "properties": {
            "ask": {
              "type": "string"
            },
            "ticket": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "description": "Только у строки простым HTTP: номер ответа, ответ на этом кадре кончается."
            },
            "kind": {
              "description": "Вид ответа: line — видимый (умолчание, в кадр не пишется), secret — скрытый, клиент читает без эха (platform/line-prompt.md).",
              "enum": [
                "line",
                "secret"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Просьба положить текст в буфер обмена того, кто позвал; клиент без буфера печатает его в stderr. На двери агента не приходит.",
          "type": "object",
          "required": [
            "clip"
          ],
          "properties": {
            "clip": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "exit"
          ],
          "properties": {
            "exit": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "http.line.collected": {
      "description": "Собранный ответ строки простым HTTP (Accept: application/json): склейка кадров потока.",
      "type": "object",
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit": {
          "type": "integer"
        },
        "ask": {
          "type": "string"
        },
        "kind": {
          "description": "Вид ответа: line — видимый (умолчание, в ответ не пишется), secret — скрытый, клиент читает без эха (platform/line-prompt.md).",
          "enum": [
            "line",
            "secret"
          ]
        },
        "ticket": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "exit"
          ]
        },
        {
          "required": [
            "ask",
            "ticket"
          ]
        }
      ],
      "additionalProperties": false
    },
    "http.line.answer": {
      "description": "Тело POST /line/answer и POST /agent/line/answer: номер вопроса и ответ. Контекст вызова тут не принимается: поле stdin, tty или env — 400 с телом {\"error\": \"контекст вызова в ответе не принимается\"} (platform/call-context.md).",
      "type": "object",
      "required": [
        "ticket",
        "answer"
      ],
      "properties": {
        "ticket": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "http.line.invalid": {
      "description": "Ответ 404 на номер неизвестный, истёкший, использованный или чужой.",
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "const": "номер подтверждения недействителен"
        }
      },
      "additionalProperties": false
    },
    "rpc.tree.snapshot": {
      "description": "Результат tree.snapshot: узлы дерева команд в глубину, дети по алфавиту.",
      "type": "object",
      "required": [
        "version",
        "nodes"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeNode"
          }
        }
      },
      "additionalProperties": false
    },
    "rpc.policy.list": {
      "description": "Результат policy.list: то же, что данные строки policy.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "rpc.schema": {
      "description": "Результат schema: этот документ.",
      "type": "object"
    },
    "treeNode": {
      "type": "object",
      "required": [
        "path",
        "summary",
        "selectors",
        "tail",
        "flags",
        "summaries"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tail": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "description": "Флаги команды: длинная форма и короткая отдельной записью; --help не входит; у групп — пусто.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "summary"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^--?[^-]"
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "summaries": {
          "description": "Назначения собственных селекторов без своего узла (allow:, ask:, deny:, forget:, policy у корня).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "path",
        "verdict"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
