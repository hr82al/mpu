{
  "name": "mpu-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "fmt": "biome format --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun --bun vitest run",
    "test:node": "node node_modules/vitest/vitest.mjs run",
    "test:deno": "deno run -A --no-config --node-modules-dir=manual node_modules/vitest/vitest.mjs run",
    "web": "cd web && bun --bun vite",
    "web:test": "cd web && bun --bun vitest run",
    "compile:web": "cd web && bun --bun vite build --outDir $MPU_OUT",
    "tools:snapshot": "bun back/scripts/gen-tool-snapshots.ts",
    "handoff": "bun handoff/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mtcute/convert": "0.31.0",
    "@mtcute/markdown-parser": "0.31.0",
    "@mtcute/node": "0.31.0",
    "@mtcute/wasm": "0.31.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "fastest-levenshtein": "1.0.16",
    "hono": "4.12.33",
    "https-proxy-agent": "7.0.6",
    "pg": "8.22.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socks-proxy-agent": "8.0.5",
    "typescript": "5.9.3",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-istanbul": "3.2.4",
    "jsdom": "26.1.0",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
