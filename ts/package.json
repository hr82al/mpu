{
  "name": "mpu-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "fmt": "biome format --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun --bun vitest run",
    "test:node": "node node_modules/vitest/vitest.mjs run",
    "test:deno": "deno run -A --no-config --node-modules-dir=manual node_modules/vitest/vitest.mjs run",
    "web:test": "cd web && node ../node_modules/vitest/vitest.mjs run",
    "smoke": "bun back/scripts/smoke.ts",
    "gate": "bun run lint && bun run typecheck && bun run test && bun run test:node && bun run test:deno && bun run web:test && bun run smoke",
    "back": "bun back/back.ts --worker back/scripts/worker.sh",
    "worker": "bun back/worker.ts",
    "cli": "bun cli/main.ts",
    "mcp": "bun mcp/main.ts",
    "complete": "bun complete/main.ts",
    "supervisor": "bun supervisor/main.ts",
    "task": "bun back/task.ts",
    "web": "cd web && bun --bun vite",
    "compile:back": "bun build --compile back/back.ts node_modules/@mpu/cmd-code/dist/repo_worker.js --root node_modules/@mpu/cmd-code/dist --outfile $MPU_OUT",
    "compile:worker": "bun build --compile back/worker.ts node_modules/@mpu/cmd-code/dist/repo_worker.js --root node_modules/@mpu/cmd-code/dist --outfile $MPU_OUT",
    "compile:mcp": "bun build --compile mcp/main.ts --outfile $MPU_OUT",
    "compile:cli": "bun build --compile cli/main.ts --outfile $MPU_OUT",
    "compile:supervisor": "bun build --compile supervisor/main.ts --outfile $MPU_OUT",
    "compile:task": "bun build --compile back/task.ts --outfile $MPU_OUT",
    "compile:complete": "bun build --compile complete/main.ts --outfile $MPU_OUT",
    "compile:web": "cd web && bun --bun vite build --outDir $MPU_OUT",
    "tools:snapshot": "bun back/scripts/gen-tool-snapshots.ts",
    "handoff": "bun handoff/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mpu/base": "file:../tslibs/base/release/mpu-base-0.1.0.tgz",
    "@mpu/cmd-code": "file:../tslibs/cmd-code/release/mpu-cmd-code-0.1.0.tgz",
    "@mpu/cmd-d2miro": "file:../tslibs/cmd-d2miro/release/mpu-cmd-d2miro-0.1.0.tgz",
    "@mpu/cmd-image": "file:../tslibs/cmd-image/release/mpu-cmd-image-0.1.0.tgz",
    "@mpu/cmd-kiten": "file:../tslibs/cmd-kiten/release/mpu-cmd-kiten-0.1.0.tgz",
    "@mpu/cmd-log": "file:../tslibs/cmd-log/release/mpu-cmd-log-0.1.0.tgz",
    "@mpu/cmd-logs": "file:../tslibs/cmd-logs/release/mpu-cmd-logs-0.1.0.tgz",
    "@mpu/cmd-mcp": "file:../tslibs/cmd-mcp/release/mpu-cmd-mcp-0.1.0.tgz",
    "@mpu/cmd-mpclone": "file:../tslibs/cmd-mpclone/release/mpu-cmd-mpclone-0.1.0.tgz",
    "@mpu/cmd-sql": "file:../tslibs/cmd-sql/release/mpu-cmd-sql-0.1.0.tgz",
    "@mpu/cmd-sun": "file:../tslibs/cmd-sun/release/mpu-cmd-sun-0.1.0.tgz",
    "@mpu/cmd-update": "file:../tslibs/cmd-update/release/mpu-cmd-update-0.1.0.tgz",
    "@mpu/command": "file:../tslibs/command/release/mpu-command-0.1.0.tgz",
    "@mpu/exec": "file:../tslibs/exec/release/mpu-exec-0.1.0.tgz",
    "@mpu/gitlab": "file:../tslibs/gitlab/release/mpu-gitlab-0.1.0.tgz",
    "@mpu/http": "file:../tslibs/http/release/mpu-http-0.1.0.tgz",
    "@mpu/invokelog": "file:../tslibs/invokelog/release/mpu-invokelog-0.1.0.tgz",
    "@mpu/kaiten": "file:../tslibs/kaiten/release/mpu-kaiten-0.1.0.tgz",
    "@mpu/language": "file:../tslibs/language/release/mpu-language-0.1.0.tgz",
    "@mpu/loki": "file:../tslibs/loki/release/mpu-loki-0.1.0.tgz",
    "@mpu/portainer": "file:../tslibs/portainer/release/mpu-portainer-0.1.0.tgz",
    "@mpu/slback": "file:../tslibs/slback/release/mpu-slback-0.1.0.tgz",
    "@mpu/subprocess": "file:../tslibs/subprocess/release/mpu-subprocess-0.1.0.tgz",
    "@mpu/telegram": "file:../tslibs/telegram/release/mpu-telegram-0.1.0.tgz",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "hono": "4.12.33",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mpu/testing": "file:../tslibs/testing/release/mpu-testing-0.1.0.tgz",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-istanbul": "3.2.4",
    "jsdom": "26.1.0",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
